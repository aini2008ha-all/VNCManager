<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:VNCManager.Converters">

    <Color x:Key="WindowBgColor">#F5F7FA</Color>
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBgColor}"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#18212F"/>
    <SolidColorBrush x:Key="PrimaryText" Color="#172033"/>
    <SolidColorBrush x:Key="SecondaryText" Color="#758197"/>
    <SolidColorBrush x:Key="BorderColor" Color="#E2E7EF"/>
    <SolidColorBrush x:Key="PrimaryBlue" Color="#2563EB"/>

    <conv:BoolVisibilityConverter x:Key="BoolVisibilityConverter"/>
    <conv:InverseBoolVisibilityConverter x:Key="InverseBoolVisibilityConverter"/>
    <conv:StatusBrushConverter x:Key="StatusBrushConverter"/>

    <Style x:Key="SidebarScrollViewer" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Style.Resources>
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="5"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#536176"/>
                <Setter Property="Opacity" Value="0.72"/>
            </Style>
        </Style.Resources>
    </Style>

    <Style x:Key="SidebarSection" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#687487"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="12,10,0,7"/>
    </Style>

    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Foreground" Value="#D8DEE8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#2563EB"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="#344054"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#D9E0EA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="SmallPrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#2563EB"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="15,7"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="MoreButton" TargetType="Button">
        <Setter Property="Foreground" Value="#697586"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="FontSize" Value="18"/>
    </Style>

    <Style x:Key="SearchBox" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E0E5ED"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Height" Value="44"/>
    </Style>

    <Style x:Key="DeviceCard" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E5E9F0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="17"/>
        <Setter Property="Margin" Value="0,0,8,12"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#4D5A6D"/>
        <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>

    <Style x:Key="InputBox" TargetType="Control">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#D9E0EA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="11,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#172033"/>
    </Style>
</ResourceDictionary>
