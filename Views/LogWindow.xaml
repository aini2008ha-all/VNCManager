<Window x:Class="VNCManager.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="操作日志" Width="900" Height="580"
        MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="操作日志" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"/>
                <TextBlock Text="记录连接、配置、设备和快捷方式等操作" Foreground="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="刷新" Click="RefreshClick" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button Content="导出" Click="ExportClick" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button Content="清空" Click="ClearClick" Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10">
            <DataGrid x:Name="LogGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="155"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding Category}" Width="90"/>
                    <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="150"/>
                    <DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,12,0,0">
            <TextBlock x:Name="LogCountText" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
            <TextBlock Text="  ·  日志文件保存在 AppData\VNCManager\logs\app.log" Foreground="#9AA3B2" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
