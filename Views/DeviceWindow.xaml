<Window x:Class="VNCManager.Views.DeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加设备" Width="560" Height="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBackground}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" Text="添加远程设备" FontSize="25"
                       FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"/>
            <TextBlock Text="支持 TightVNC 与 Windows 远程桌面 (RDP)" Foreground="{StaticResource SecondaryText}"
                       Margin="0,5,0,18"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="连接类型" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <RadioButton x:Name="TypeVnc" Content="📡  VNC（TightVNC）" IsChecked="True"
                                 Margin="0,0,24,0" FontSize="13" Checked="TypeChanged"/>
                    <RadioButton x:Name="TypeRdp" Content="🖥  远程桌面（RDP）" FontSize="13" Checked="TypeChanged"/>
                </StackPanel>

                <TextBlock Text="设备名称" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NameBox" Style="{StaticResource InputBox}" Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,15">
                        <TextBlock Text="IP 地址 / 主机名" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="HostBox" Style="{StaticResource InputBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,0,15">
                        <TextBlock Text="端口" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="PortBox" Style="{StaticResource InputBox}"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="UserLabel" Text="用户名（RDP 建议填写）" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="UserBox" Style="{StaticResource InputBox}" Margin="0,0,0,15"/>

                <TextBlock Text="密码（可选）" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputBox}" Margin="0,0,0,4"/>
                <TextBlock x:Name="PasswordHint" Text="" Foreground="#758197" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,15"/>

                <TextBlock Text="分组" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="GroupBox" IsEditable="True" Height="36"
                          FontSize="13" Padding="8,6" Margin="0,0,0,4"/>
                <TextBlock Text="可直接输入新分组名，保存后出现在左侧列表" Foreground="#758197"
                           FontSize="11" Margin="0,0,0,15"/>

                <TextBlock Text="备注" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="CommentBox" Height="64" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Style="{StaticResource InputBox}"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Click="CancelClick" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
            <Button Content="保存设备" Click="SaveClick" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
