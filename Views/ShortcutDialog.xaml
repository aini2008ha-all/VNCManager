<Window x:Class="VNCManager.Views.ShortcutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷方式" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBackground}">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Text="添加快捷方式" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryText}" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Text="类型" Style="{StaticResource FieldLabel}"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton x:Name="TypeExe" Content="程序 (.exe)" IsChecked="True" Margin="0,0,18,0"/>
            <RadioButton x:Name="TypeFolder" Content="文件夹" Margin="0,0,18,0"/>
            <RadioButton x:Name="TypeUrl" Content="网页"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="路径 / 网址" Style="{StaticResource FieldLabel}"/>
        <Grid Grid.Row="4" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TargetBox" Style="{StaticResource InputBox}" Height="36"/>
            <Button Grid.Column="1" Content="浏览..." Click="BrowseClick"
                    Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Height="36"/>
        </Grid>

        <TextBlock Grid.Row="5" Text="显示名称（留空则使用默认）" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameBox" Grid.Row="6" Style="{StaticResource InputBox}" Height="36" Margin="0,0,0,18"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Click="CancelClick" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
            <Button Content="确定" Click="OkClick" Style="{StaticResource PrimaryButton}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
