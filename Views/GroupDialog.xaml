<Window x:Class="VNCManager.Views.GroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="分组" Width="440" SizeToContent="Height"
        MinHeight="300" MaxHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBackground}">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="新建分组" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryText}" Margin="0,0,0,18"/>

        <TextBlock Grid.Row="1" Text="分组名称" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameBox" Grid.Row="2" Style="{StaticResource InputBox}"
                 Height="36" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="3" Text="排序值（数值越大越靠前）" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="SortBox" Grid.Row="4" Style="{StaticResource InputBox}"
                 Height="36" Margin="0,0,0,8" Text="0"/>
        <TextBlock Grid.Row="5" Text="例如：办公室设为 100，默认 0，则办公室会排在更上面。"
                   Foreground="#758197" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,18"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Click="CancelClick" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
            <Button Content="确定" Click="OkClick" Style="{StaticResource PrimaryButton}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
